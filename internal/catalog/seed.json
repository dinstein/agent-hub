{
  "version": 1,
  "entries": [
    {
      "id": "filesystem",
      "name": "Filesystem",
      "description": "Read, write and search files under directories you explicitly allow.",
      "publisher": "modelcontextprotocol",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
      "provenance": "curated",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "{{directory}}"],
      "params": [
        {
          "name": "directory",
          "description": "Absolute path the server may read and write. Nothing outside it is reachable.",
          "example": "/Users/me/projects"
        }
      ],
      "tags": ["files", "local", "reference"]
    },
    {
      "id": "git",
      "name": "Git",
      "description": "Inspect a local Git repository: status, diffs, log and blame.",
      "publisher": "modelcontextprotocol",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
      "provenance": "curated",
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "{{repository}}"],
      "params": [
        {
          "name": "repository",
          "description": "Absolute path of the Git working tree to expose.",
          "example": "/Users/me/projects/agent-hub"
        }
      ],
      "tags": ["git", "vcs", "local", "reference"]
    },
